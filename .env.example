# Cloud sync is optional. Without these the app is local-only: everything works
# on IndexedDB, sign-in and profile settings simply report sync as unavailable.
#
# Copy to .env.local and fill in from Supabase > Project Settings > API.
# Because the names are NEXT_PUBLIC_, these values are bundled into the static
# JavaScript and are visible to anyone who opens the page. That is expected for
# the anon key, which is designed to be public. Never put a service-role key here:
# it bypasses row level security and would hand over every user's data.
#
# Both values are read at build time, so a change needs a rebuild, not just a
# restart. The anon key must be the "anon / public" key, not the service_role key.
#
#   NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Password recovery links return to the app root, and this build is statically
# exported, so the redirect lands on /index.html rather than a route. Add your
# deployed origin under Authentication > URL Configuration > Redirect URLs as
# well as Site URL, otherwise resetPasswordForEmail silently sends you nowhere.
# Both the production origin and http://localhost:3100 are worth listing.
